# ============================================================
# Vayudrishti-AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your API credentials.
# NEVER commit your actual .env file to version control.
# ============================================================

# OpenAQ v3 API Key (Required for ground station queries)
# Register free at: https://openaq.org
OPENAQ_API_KEY=your_openaq_api_key_here

# Google Earth Engine (Optional, for running cloud-based GEE satellite exports)
GEE_PROJECT_ID=your_gee_cloud_project_id
GEE_SERVICE_ACCOUNT=your_service_account@project.iam.gserviceaccount.com
GEE_KEY_FILE=path/to/gee_credentials.json

# Open-Meteo API (Free tier requires no key; commercial key optional)
OPEN_METEO_API_KEY=

# Server / API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Matplotlib cache directory inside workspace (prevents permission warnings)
MPLCONFIGDIR=.matplotlib

